# EmailJS Configuration
# Sign up at https://www.emailjs.com to get these values
# Free plan: 200 emails/month

VITE_EMAILJS_SERVICE_ID=service_mcvd
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE
VITE_EMAILJS_TEMPLATE_CONFIRM=template_confirm
VITE_EMAILJS_TEMPLATE_REMINDER=template_reminder
VITE_EMAILJS_TEMPLATE_FORM=template_form_link
VITE_EMAILJS_TEMPLATE_BUDGET=template_budget

# Acceso al panel (obligatorio: sin estas variables nadie puede iniciar sesión)
# Hash de la contraseña:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" 'tu-contraseña'
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD_HASH=

# Cuenta secundaria de primer uso: arranca con todos los datos en cero (opcional)
#   Mismo generador de hash que arriba.
VITE_SETUP_USER=
VITE_SETUP_PASSWORD_HASH=

